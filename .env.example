# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Temporary variable for pre-launch preview to show the developer authentication toolbar.
# IMPORTANT: This must be disabled or removed before actual public launch.
NEXT_PUBLIC_SHOW_DEV_TOOLBAR=true

# Supabase Keys
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary — unsigned browser uploads for customer-supplied photos.
# Both values are public by design (an unsigned preset carries no secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dwg0hr34g"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="alreha"

# SUPABASE_SERVICE_ROLE_KEY — لإنشاء الحسابات ودعوة المستخدمين من لوحة الإدارة.
# ⚠️ المفتاح ده بيتخطى كل قواعد الحماية في قاعدة البيانات.
# - خادم فقط: من غير بادئة NEXT_PUBLIC_ عشان ما يوصلش للمتصفح إطلاقًا
# - ما يتحطش في Git إطلاقًا — يتحط في Vercel وفي .env.local المحلي بس
# - قيمته من: Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NEXT_PUBLIC_SITE_URL — الدومين الحقيقي للموقع، من غير شرطة في الآخر.
# ده اللي بيتكتب في الروابط القانونية (canonical) وخريطة الموقع وصور المشاركة.
# لازم يتظبط في Vercel؛ من غيره الموقع بيستخدم قيمة احتياطية مكتوبة في الكود.
NEXT_PUBLIC_SITE_URL=https://alrehlat.vercel.app
